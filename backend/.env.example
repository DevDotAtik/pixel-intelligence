# ============================================================================
# PIXEL INTELLIGENCE — BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and adjust for your machine. Every value has a safe
# default, so the package runs out-of-the-box with just MongoDB + a webcam.
# ============================================================================

# --- MongoDB (required: primary database for events, subjects, registrations) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pixel_intelligence

# --- Detection models (absolute or backend-relative paths) ---
# model.pt        = compact face detector (~6 MB)  — default
# yolov8m-face.pt = higher-accuracy face detector
# yolov8n.pt      = COCO model with a 'person' class (recommended for person detection)
FACE_MODEL_PATH=
OBJECT_MODEL_PATH=
PLATE_MODEL_PATH=

# --- Runtime tuning ---
CONFIDENCE_THRESHOLD=0.50
INFERENCE_SIZE=320            # lower = faster on CPU (320 recommended for low-end laptops)
PROCESS_EVERY_N_FRAMES=3      # run inference on every Nth camera frame
CAMERA_INDEX=0                # webcam device index (/dev/video0)
IMAGE_WIDTH=640
IMAGE_HEIGHT=480
JPEG_QUALITY=75               # lighter frames = faster MJPEG loop
CPU_THREADS=4

# --- Facial recognition ---
FACE_MATCH_THRESHOLD=0.72     # cosine similarity above this => "registered person"
FACE_EMBED_SIZE=64

# --- Timeline / dedup behaviour ---
VANISH_SECONDS=5              # subject considered "gone" after 5s unseen from a camera
MIN_SIGHTING_SECONDS=1        # minimum length of a continuous sighting before it is finalised

# --- Django camera gateway base URL (used by the Next.js console) ---
NEXT_PUBLIC_DJANGO_URL=http://127.0.0.1:8001
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000