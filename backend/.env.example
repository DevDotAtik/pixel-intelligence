# ============================================================================
# PIXEL INTELLIGENCE — BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and adjust for your machine. Every value has a safe
# default, so the package runs out-of-the-box with just MongoDB + a webcam.
# ============================================================================

# --- MongoDB (required: primary database for events, subjects, registrations) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pixel_intelligence

# --- Detection models (absolute or backend-relative paths) ---
# model.pt        = compact face detector (~6 MB)  — default
# yolov8m-face.pt = higher-accuracy face detector
# yolov8n.pt      = COCO model with a 'person' class (recommended for person detection)
FACE_MODEL_PATH=
OBJECT_MODEL_PATH=
PLATE_MODEL_PATH=

# --- Runtime tuning ---
CONFIDENCE_THRESHOLD=0.40      # lower = catches fainter/smaller objects (accuracy/recall)
INFERENCE_SIZE=640             # higher = better accuracy; 480 compromise, 320 fastest on weak laptops
PROCESS_EVERY_N_FRAMES=3       # run inference on every Nth camera frame (low = fresher overlays)
CAMERA_INDEX=0                 # webcam device index (/dev/video0)
# Optional network video source — wins over CAMERA_INDEX when set. Works with a
# phone "IP Webcam" MJPEG feed (http://192.168.1.50:8080/video) or an RTSP camera.
#CAMERA_URL=
IMAGE_WIDTH=640
IMAGE_HEIGHT=480
JPEG_QUALITY=85                # higher = sharper frames for detection; heavier MJPEG loop (75 = lighter/faster)
STREAM_FPS=30                  # cap for the Django MJPEG streaming loop (raise to 45/60 if CPU allows)
MIRROR_CAMERA=1                # mirror the LOCAL webcam feed (selfie style) by default; network
                               # RTSP/MJPEG cameras always stream un-mirrored unless a camera row
                               # or the console's MIRROR toggle says otherwise
CPU_THREADS=4

# --- CCTV camera registry polling (Django camera gateway) ---
# The console's Camera Fleet page registers RTSP/MJPEG sources in Mongo
# (FastAPI owns the data). Django refreshes that registry every N seconds so a
# newly added camera becomes streamable without restarting the gateway.
CAMERA_REGISTRY_TTL_SECONDS=15

# --- Face recognition ---
FACE_MATCH_THRESHOLD=0.75      # webcam ArcFace cosine needed to name someone
FACE_MATCH_MARGIN=0.12         # min best-vs-runner-up gap; ties stay UNKNOWN
FACE_MATCH_MIN_FACE=64         # smallest live face bbox side (px) worth identifying
FACE_MATCH_MIN_SHARPNESS=45    # Laplacian variance; blurred crops stay UNKNOWN
FACE_MATCH_MIN_BRIGHTNESS=45   # reject very dark crops
FACE_MATCH_MAX_BRIGHTNESS=210  # reject very overexposed crops
FACE_MATCH_CONFIRM=2           # same name must win this many independent checks
FACE_ENROLL_MIN_SAMPLES=3      # require front / slight-left / slight-right reference photos
FACE_ENROLL_MAX_SAMPLES=5
FACE_ENROLL_MIN_FACE=96
FACE_ENROLL_MIN_SHARPNESS=60
IDENTITY_REFRESH_SECONDS=0.75  # how often a subject's embedding is recomputed
FACE_EMBED_SIZE=64             # descriptor dim of the histogram fallback embedder (ONNX uses 512)

# --- Timeline / dedup behaviour ---
VANISH_SECONDS=5              # subject considered "gone" after 5s unseen from a camera
MIN_SIGHTING_SECONDS=1        # minimum length of a continuous sighting before it is finalised

# --- Django camera gateway base URL (used by the Next.js console) ---
NEXT_PUBLIC_DJANGO_URL=http://127.0.0.1:8001
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
